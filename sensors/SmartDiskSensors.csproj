<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads CPU / GPU / motherboard sensors with LibreHardwareMonitorLib (MPL-2.0) and prints one JSON object.
       CPU and Super I/O (fans, voltages) need the PawnIO driver; GPUs are read without it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>smartdisk-sensors</AssemblyName>
    <RootNamespace>SmartDiskSensors</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Copyright>Copyright (c) 2026 PLANET COMPUTER TECHNOLOGY CENTRE</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>
</Project>
