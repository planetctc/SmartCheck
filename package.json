{
  "name": "smartdisk",
  "productName": "smartCheck",
  "version": "0.18.0",
  "description": "smartCheck - 电脑健康检测",
  "main": "app/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:mock": "cross-env SMARTDISK_MOCK=1 electron .",
    "build:helper": "cmake -S helper -B helper/build -A x64 && cmake --build helper/build --config Release",
    "build:diskspd": "powershell -NoProfile -ExecutionPolicy Bypass -File helper/build-diskspd.ps1",
    "dist": "npm run build:helper && npm run build:diskspd && npm run build:sensors && electron-builder --win nsis --x64 --publish never",
    "release": "npm run build:helper && npm run build:diskspd && npm run build:sensors && electron-builder --win nsis --x64 --publish always",
    "build:sensors": "powershell -NoProfile -ExecutionPolicy Bypass -File helper/build-sensors.ps1"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "my.planetcomputer.smartdisk",
    "productName": "smartCheck",
    "executableName": "smartDisk",
    "files": [
      "app/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "helper/build/Release/smartdisk-helper.exe",
        "to": "helper/smartdisk-helper.exe"
      },
      {
        "from": "third_party/diskspd/diskspd_vs/x64/Release/diskspd.exe",
        "to": "helper/diskspd.exe"
      },
      {
        "from": "third_party/diskspd/LICENSE",
        "to": "helper/diskspd-LICENSE.txt"
      },
      {
        "from": "sensors/out",
        "to": "helper/sensors",
        "filter": [
          "**/*.exe",
          "**/*.dll",
          "**/*.config"
        ]
      },
      {
        "from": "sensors/THIRD-PARTY.txt",
        "to": "helper/sensors/THIRD-PARTY.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "smartCheck",
      "artifactName": "smartCheck-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "copyright": "Copyright (c) 2026 PLANET COMPUTER TECHNOLOGY CENTRE. All rights reserved.",
    "publish": [
      {
        "provider": "github",
        "owner": "planetctc",
        "repo": "smartCheck-releases",
        "releaseType": "release"
      }
    ]
  },
  "author": "PLANET COMPUTER TECHNOLOGY CENTRE",
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
